<?xml version='1.0' encoding='utf-8'?>
<ns0:AUTOSAR xmlns:ns0="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00050.xsd">
  <ns0:AR-PACKAGE>
    <ns0:SHORT-NAME>DoIP_RoutingActivation_Extract</ns0:SHORT-NAME>
    <ns0:ELEMENTS>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DocumentMetadata</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>Source: AUTOSAR_SWS_DiagnosticOverIP.pdf</ns0:P>
          <ns0:P>Release: AUTOSAR Classic Platform R21-11</ns0:P>
          <ns0:P>DocumentID: 418</ns0:P>
          <ns0:P>Scope: Routing Activation configuration and supporting configuration explicitly used by its processing flow</ns0:P>
          <ns0:P>Caveat: Traceable knowledge extract in an AUTOSAR-style XML envelope; not validated against the AUTOSAR ECUC schema and not intended for direct ECU configuration-tool import.</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPRoutingActivationNumber</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPRoutingActivationNumber</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00033</ns0:P>
          <ns0:P>ParentContainer: DoIPRoutingActivation</ns0:P>
          <ns0:P>Type: EcucIntegerParamDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: 0..255</ns0:P>
          <ns0:P>Multiplicity: 1</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: true</ns0:P>
          <ns0:P>Description: Identifies the Routing Activation Number expected in a Routing Activation request.</ns0:P>
          <ns0:P>RoutingActivationRelationship: Matched against request Activation Type under SWS_DoIP_00108.</ns0:P>
          <ns0:P>SourceReference: 10.2.23, PDF p. 119; 7.3.2.3.1, PDF p. 37</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPTargetAddressRef</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPTargetAddressRef</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00034</ns0:P>
          <ns0:P>ParentContainer: DoIPRoutingActivation</ns0:P>
          <ns0:P>Type: Reference to DoIPTargetAddress</ns0:P>
          <ns0:P>RangeOrReferenceTarget: Target: DoIPTargetAddress</ns0:P>
          <ns0:P>Multiplicity: 1..65535</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: true</ns0:P>
          <ns0:P>Description: Reference to all DoIPTargetAddress entries activated by this Routing Activation.</ns0:P>
          <ns0:P>RoutingActivationRelationship: Successful activation enables routing to configured target addresses under SWS_DoIP_00113.</ns0:P>
          <ns0:P>SourceReference: 10.2.23, PDF p. 120; 7.3.2.3.1, PDF p. 38</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPRoutingActivationSecurityRequired</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPRoutingActivationSecurityRequired</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00096</ns0:P>
          <ns0:P>ParentContainer: DoIPRoutingActivation</ns0:P>
          <ns0:P>Type: EcucBooleanParamDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: Boolean</ns0:P>
          <ns0:P>Multiplicity: 0..1</ns0:P>
          <ns0:P>DefaultValue: false</ns0:P>
          <ns0:P>PostBuildVariant: Not stated in extracted table</ns0:P>
          <ns0:P>Description: Indicates whether this Routing Activation requires a secure TCP connection.</ns0:P>
          <ns0:P>RoutingActivationRelationship: Evaluated with the TCP connection security setting under SWS_DoIP_00294/00295.</ns0:P>
          <ns0:P>SourceReference: 10.2.23, PDF p. 120; 7.2, PDF p. 27</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPRoutingActivationAuthenticationFunc</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPRoutingActivationAuthenticationFunc</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00037</ns0:P>
          <ns0:P>ParentContainer: DoIPRoutingActivationAuthenticationCallback</ns0:P>
          <ns0:P>Type: EcucFunctionNameDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: Function name</ns0:P>
          <ns0:P>Multiplicity: 0..1</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: Not specified</ns0:P>
          <ns0:P>Description: Function name for the Routing Activation authentication callback.</ns0:P>
          <ns0:P>RoutingActivationRelationship: If omitted while the callback container is configured, the spec describes use of an RPort of service interface &lt;RoutingActivation&gt;_RoutingActivation named CB&lt;RoutingActivation&gt;RoutingActivation. See SWS_DoIP_00109–00111 and API SWS_DoIP_00049.</ns0:P>
          <ns0:P>SourceReference: 10.2.24, PDF pp. 120–121; 8.6.3.3, PDF p. 73</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPRoutingActivationAuthenticationReqLength</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPRoutingActivationAuthenticationReqLength</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00040</ns0:P>
          <ns0:P>ParentContainer: DoIPRoutingActivationAuthenticationCallback</ns0:P>
          <ns0:P>Type: EcucIntegerParamDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: 0..4 bytes</ns0:P>
          <ns0:P>Multiplicity: 1</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: false</ns0:P>
          <ns0:P>Description: Number of OEM-specific request bytes used by authentication.</ns0:P>
          <ns0:P>RoutingActivationRelationship: If non-zero, the configured request bytes are supplied to the authentication callback.</ns0:P>
          <ns0:P>SourceReference: 10.2.24, PDF p. 121; 8.6.3.3, PDF p. 73</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPRoutingActivationAuthenticationResLength</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPRoutingActivationAuthenticationResLength</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00041</ns0:P>
          <ns0:P>ParentContainer: DoIPRoutingActivationAuthenticationCallback</ns0:P>
          <ns0:P>Type: EcucIntegerParamDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: 0..4 bytes</ns0:P>
          <ns0:P>Multiplicity: 1</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: false</ns0:P>
          <ns0:P>Description: Number of bytes used for authentication response data; if zero, AuthenticationResData is not fetched via the API.</ns0:P>
          <ns0:P>RoutingActivationRelationship: If non-zero, authentication response bytes are included in the Routing Activation Response OEM-specific field under SWS_DoIP_00120.</ns0:P>
          <ns0:P>SourceReference: 10.2.24, PDF p. 121; 7.3.2.3.1–7.3.2.3.2, PDF pp. 37–39</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPRoutingActivationConfirmationFunc</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPRoutingActivationConfirmationFunc</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00064</ns0:P>
          <ns0:P>ParentContainer: DoIPRoutingActivationConfirmationCallback</ns0:P>
          <ns0:P>Type: EcucFunctionNameDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: Function name</ns0:P>
          <ns0:P>Multiplicity: 0..1</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: Not specified</ns0:P>
          <ns0:P>Description: Function name for the Routing Activation confirmation callback.</ns0:P>
          <ns0:P>RoutingActivationRelationship: If omitted while the callback container is configured, the spec describes use of an RPort of service interface &lt;RoutingActivation&gt;_RoutingActivation named CB&lt;RoutingActivation&gt;RoutingActivation. See SWS_DoIP_00112, SWS_DoIP_00114 and SWS_DoIP_00274.</ns0:P>
          <ns0:P>SourceReference: 10.2.25, PDF pp. 121–122; 8.6.3.2, PDF p. 72</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPRoutingActivationConfirmationReqLength</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPRoutingActivationConfirmationReqLength</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00065</ns0:P>
          <ns0:P>ParentContainer: DoIPRoutingActivationConfirmationCallback</ns0:P>
          <ns0:P>Type: EcucIntegerParamDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: 0..4 bytes</ns0:P>
          <ns0:P>Multiplicity: 1</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: false</ns0:P>
          <ns0:P>Description: Number of OEM-specific request bytes supplied to the confirmation function.</ns0:P>
          <ns0:P>RoutingActivationRelationship: If non-zero, the callback handles the configured trailing bytes of the OEM-specific request field.</ns0:P>
          <ns0:P>SourceReference: 10.2.25, PDF p. 122; 8.6.3.2, PDF p. 72</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPRoutingActivationConfirmationResLength</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPRoutingActivationConfirmationResLength</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00066</ns0:P>
          <ns0:P>ParentContainer: DoIPRoutingActivationConfirmationCallback</ns0:P>
          <ns0:P>Type: EcucIntegerParamDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: 0..4 bytes</ns0:P>
          <ns0:P>Multiplicity: 1</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: false</ns0:P>
          <ns0:P>Description: Number of OEM-specific response bytes returned by the confirmation function.</ns0:P>
          <ns0:P>RoutingActivationRelationship: If non-zero and confirmation returns E_OK, response bytes are attached to the OEM-specific field under SWS_DoIP_00112/SWS_DoIP_00120.</ns0:P>
          <ns0:P>SourceReference: 10.2.25, PDF p. 122; 7.3.2.3.1–7.3.2.3.2, PDF pp. 38–39</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPTesterSA</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPTesterSA</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00043</ns0:P>
          <ns0:P>ParentContainer: DoIPTester</ns0:P>
          <ns0:P>Type: EcucIntegerParamDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: 0..65535 (16-bit logical address)</ns0:P>
          <ns0:P>Multiplicity: 1</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: true</ns0:P>
          <ns0:P>Description: Source Address of the tester sent via Routing Activation or diagnostic message.</ns0:P>
          <ns0:P>RoutingActivationRelationship: Request Source Address is matched against configured DoIPTesterSA under SWS_DoIP_00102; echoed as Logical Address Tester under SWS_DoIP_00116.</ns0:P>
          <ns0:P>SourceReference: 10.2.26, PDF p. 125; 7.3.2.3.1–7.3.2.3.2, PDF pp. 36 and 39</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPRoutingActivationRef</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPRoutingActivationRef</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00062</ns0:P>
          <ns0:P>ParentContainer: DoIPTester</ns0:P>
          <ns0:P>Type: Reference to DoIPRoutingActivation</ns0:P>
          <ns0:P>RangeOrReferenceTarget: Target: DoIPRoutingActivation</ns0:P>
          <ns0:P>Multiplicity: 1..255</ns0:P>
          <ns0:P>DefaultValue: Not specified</ns0:P>
          <ns0:P>PostBuildVariant: true</ns0:P>
          <ns0:P>Description: References possible Routing Activations for this tester.</ns0:P>
          <ns0:P>RoutingActivationRelationship: Activation Type is matched against DoIPRoutingActivationNumber in one of the referenced activations under SWS_DoIP_00108.</ns0:P>
          <ns0:P>SourceReference: 10.2.26, PDF p. 125; 7.3.2.3.1, PDF p. 37</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPMaxTesterConnections</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPMaxTesterConnections</ns0:P>
          <ns0:P>ECUCItemID: Not verified in extracted parameter table</ns0:P>
          <ns0:P>ParentContainer: DoIPGeneral (parent to verify)</ns0:P>
          <ns0:P>Type: Not verified</ns0:P>
          <ns0:P>RangeOrReferenceTarget: Not verified</ns0:P>
          <ns0:P>Multiplicity: Not verified</ns0:P>
          <ns0:P>DefaultValue: Not verified</ns0:P>
          <ns0:P>PostBuildVariant: Not verified</ns0:P>
          <ns0:P>Description: Maximum registered tester connections considered during Routing Activation.</ns0:P>
          <ns0:P>RoutingActivationRelationship: SWS_DoIP_00107 compares registered connections against this parameter. Exact ECUC item ID, range, default, and type need verification in the full configuration table.</ns0:P>
          <ns0:P>SourceReference: 7.3.2.3.1, PDF p. 36; configuration table not verified in this extraction</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPAliveCheckResponseTimeout</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPAliveCheckResponseTimeout</ns0:P>
          <ns0:P>ECUCItemID: Not verified in extracted parameter table</ns0:P>
          <ns0:P>ParentContainer: Parent container to verify</ns0:P>
          <ns0:P>Type: Not verified</ns0:P>
          <ns0:P>RangeOrReferenceTarget: Not verified</ns0:P>
          <ns0:P>Multiplicity: Not verified</ns0:P>
          <ns0:P>DefaultValue: Not verified</ns0:P>
          <ns0:P>PostBuildVariant: Not verified</ns0:P>
          <ns0:P>Description: Configured wait time for an Alive Check response.</ns0:P>
          <ns0:P>RoutingActivationRelationship: Used by SWS_DoIP_00105 and SWS_DoIP_00140. Exact unit, range, default, and ECUC item ID need verification in the full configuration table.</ns0:P>
          <ns0:P>SourceReference: 7.3.2.3.1, PDF p. 36; 7.3.2.4.1, PDF p. 39; configuration table not verified</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPTcpConnectionSecurityRequired</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPTcpConnectionSecurityRequired</ns0:P>
          <ns0:P>ECUCItemID: Not verified in extracted parameter table</ns0:P>
          <ns0:P>ParentContainer: DoIPTcpConnection</ns0:P>
          <ns0:P>Type: EcucBooleanParamDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: Boolean</ns0:P>
          <ns0:P>Multiplicity: 1</ns0:P>
          <ns0:P>DefaultValue: false (if not set)</ns0:P>
          <ns0:P>PostBuildVariant: Not verified</ns0:P>
          <ns0:P>Description: Indicates whether the TCP connection is configured to require a secure connection.</ns0:P>
          <ns0:P>RoutingActivationRelationship: Evaluated together with DoIPRoutingActivationSecurityRequired under SWS_DoIP_00294/00295.</ns0:P>
          <ns0:P>SourceReference: 10.2.15, PDF p. 113; 7.2, PDF p. 27; ECUC item ID/table details not verified</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPLogicalAddress</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPLogicalAddress</ns0:P>
          <ns0:P>ECUCItemID: Not verified in extracted parameter table</ns0:P>
          <ns0:P>ParentContainer: DoIP</ns0:P>
          <ns0:P>Type: Not verified</ns0:P>
          <ns0:P>RangeOrReferenceTarget: Not verified</ns0:P>
          <ns0:P>Multiplicity: Not verified</ns0:P>
          <ns0:P>DefaultValue: Not verified</ns0:P>
          <ns0:P>PostBuildVariant: Not verified</ns0:P>
          <ns0:P>Description: Configured logical address of the DoIP entity.</ns0:P>
          <ns0:P>RoutingActivationRelationship: Used as Logical Address DoIP entity in Routing Activation Response under SWS_DoIP_00118. Exact configuration-table details not included in this extract.</ns0:P>
          <ns0:P>SourceReference: 7.3.2.3.2, PDF p. 39; configuration table not verified</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
      <ns0:ANNOTATION>
        <ns0:LABELS>
          <ns0:L-4>DoIPMaxRequestBytes</ns0:L-4>
        </ns0:LABELS>
        <ns0:ANNOTATION-TEXT>
          <ns0:P>ParameterName: DoIPMaxRequestBytes</ns0:P>
          <ns0:P>ECUCItemID: ECUC_DoIP_00019</ns0:P>
          <ns0:P>ParentContainer: DoIPGeneral</ns0:P>
          <ns0:P>Type: EcucIntegerParamDef</ns0:P>
          <ns0:P>RangeOrReferenceTarget: 1 .. 4294967295</ns0:P>
          <ns0:P>Multiplicity: 1</ns0:P>
          <ns0:P>DefaultValue: Not specified in the source table</ns0:P>
          <ns0:P>PostBuildVariant: false</ns0:P>
          <ns0:P>ValueConfigurationClass: Pre-compile time</ns0:P>
          <ns0:P>Description: Specifies the maximum allowed bytes of a DoIP message request without the DoIP header.</ns0:P>
          <ns0:P>SectionRelationship: Under SWS_DoIP_00017, if a received message payload length exceeds this configured value, the DoIP module sends NACK 0x02 and discards the message.</ns0:P>
          <ns0:P>SourceReference: 10.2.3, PDF p. 89; 7.3.2.1, PDF p. 30; SWS_DoIP_00017</ns0:P>
          <ns0:P>ExtractionNote: Supporting DoIPGeneral parameter referenced by the Generic acknowledge section; it is not a child of DoIPRoutingActivation.</ns0:P>
        </ns0:ANNOTATION-TEXT>
      </ns0:ANNOTATION>
    </ns0:ELEMENTS>
  </ns0:AR-PACKAGE>
</ns0:AUTOSAR>